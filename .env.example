# API
NODE_ENV=development
PORT=3000

# Database SQLite
DATABASE_PATH=./data/game.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Game Config
STAMINA_REGEN_INTERVAL=300000
STAMINA_REGEN_AMOUNT=1
MAX_STAMINA=100

# S3 (Optional, for battle logs)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
