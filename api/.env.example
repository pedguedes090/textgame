# Server Configuration
NODE_ENV=development
PORT=3000

# Database - SQLite
DATABASE_PATH=./data/game.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Game Config
STAMINA_MAX=100
STAMINA_REGEN_INTERVAL_MS=300000

# Logging
LOG_LEVEL=debug
